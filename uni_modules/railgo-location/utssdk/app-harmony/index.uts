import {
	HarmonyLocationInfo,
	HarmonyGetLocationOptions
} from '../interface.uts';

import { geoLocationManager } from '@kit.LocationKit';
import { abilityAccessCtrl, common } from '@kit.AbilityKit';
import { BusinessError } from '@kit.BasicServicesKit';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = 'RailGoLocation';

// 授权状态缓存：授权过一次后不再重复申请
let permissionGranted = false;

// 获取 UIAbility 上下文
function getAbilityContext() : common.UIAbilityContext {
	return getContext() as common.UIAbilityContext;
}

// 申请定位权限（已授权时系统直接返回，不弹框；仅首次会弹出）
function ensurePermission() : Promise<boolean> {
	if (permissionGranted) {
		return Promise.resolve(true);
	}
	let atManager = abilityAccessCtrl.createAtManager();
	return atManager.requestPermissionsFromUser(getAbilityContext(), [
		'ohos.permission.APPROXIMATELY_LOCATION',
		'ohos.permission.LOCATION'
	]).then(() => {
		permissionGranted = true;
		return true;
	}).catch((error : BusinessError) => {
		hilog.error(0, TAG, 'ensurePermission error: %{public}s', error.message);
		return false;
	});
}

/**
 * 鸿蒙端单次定位（同时订阅卫星状态）
 */
export function getHarmonyLocationOnce(options : HarmonyGetLocationOptions) : void {
	ensurePermission().then((granted : boolean) => {
		if (!granted) {
			options.fail?.('位置权限未授予，无法获取定位');
			return;
		}

		// 1. 订阅 GNSS 卫星状态变化
		let satellitesNumber = 0;
		let satelliteCallback = (satelliteInfo : geoLocationManager.SatelliteStatusInfo) => {
			if (satelliteInfo != null && satelliteInfo.satellitesNumber > 0) {
				satellitesNumber = satelliteInfo.satellitesNumber;
			}
		};
		try {
			geoLocationManager.on('satelliteStatusChange', satelliteCallback);
		} catch (err) {
			hilog.error(0, TAG, 'subscribe satelliteStatusChange error: %{public}s', (err as BusinessError).message);
		}

		// 2. 单次定位请求（精度优先，1500ms 超时）
		let request : geoLocationManager.SingleLocationRequest = {
			locatingPriority: geoLocationManager.LocatingPriority.PRIORITY_ACCURACY,
			locatingTimeoutMs: 1500
		};

		// 3. 发起单次定位
		geoLocationManager.getCurrentLocation(request).then((loc : geoLocationManager.Location) => {
			try {
				geoLocationManager.off('satelliteStatusChange', satelliteCallback);
			} catch (err) {
				// 忽略取消订阅异常
			}

			let info : HarmonyLocationInfo = {
				latitude: loc.latitude,
				longitude: loc.longitude,
				altitude: loc.altitude,
				speed: loc.speed,
				sourceType: satellitesNumber > 0 ? 'GPS' : '系统定位',
				satellites: satellitesNumber,
				locationProvider: satellitesNumber > 0 ? 'GPS' : '系统定位'
			};
			options.success?.(info);
		}).catch((error : BusinessError) => {
			try {
				geoLocationManager.off('satelliteStatusChange', satelliteCallback);
			} catch (err) {
				// 忽略取消订阅异常
			}
			hilog.error(0, TAG, 'getCurrentLocation error: %{public}s', error.message);
			options.fail?.('定位失败：' + error.message);
		});
	}).catch((error : BusinessError) => {
		hilog.error(0, TAG, 'getHarmonyLocationOnce error: %{public}s', error.message);
		options.fail?.('定位流程异常：' + error.message);
	});
}
