/**
 * 前台扫描标签广播接收器（参照 Sfiora 成品插件 NfcForegroundReceiver 的已验证模式）。
 *
 * enableForegroundDispatch 的 PendingIntent 目标是 BroadcastReceiver 而非 Activity：
 * 广播在现有 App 进程内分发，不起新 Activity、不需要 intent-filter、
 * 也没有"分发 Activity 栈反调 JS"和冷启动的崩溃面。
 *
 * 必须独立成文件并在构造函数显式 super()：
 * 参照本项目 laoqianjunzi-widget/AppWidget.uts（AppWidgetProvider 即 BroadcastReceiver 子类）。
 * ⚠️ 依赖严格单向：本文件只 import './tag-core.uts'，绝不能 import './index.uts'（循环会被编译器静默丢弃）。
 */
import Context from 'android.content.Context';
import Intent from 'android.content.Intent';
import BroadcastReceiver from 'android.content.BroadcastReceiver';
import { handleForegroundIntent } from './tag-core.uts';

/** 组件声明类名（index.uts 引用来构建 PendingIntent，同时强制本文件进入编译图） */
export function tagReceiverName() : string {
	return 'uts.sdk.modules.railgoNfc.NfcTagReceiver'
}

export class NfcTagReceiver extends BroadcastReceiver {

	constructor() {
		super()
	}

	override onReceive(context: Context, intent: Intent): void {
		try {
			handleForegroundIntent(intent)
		} catch (e : any) {
			// 只入队，任何异常都不外抛（接收器抛异常会杀进程）
			console.error('[railgo-nfc] receiver error: ' + e)
		}
	}
}
