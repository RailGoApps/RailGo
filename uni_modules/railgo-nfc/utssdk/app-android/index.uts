/**
 * railgo-nfc Android 实现（对外 API 入口）
 *
 * 文件结构（依赖严格单向，index → 其他文件）：
 * - index.uts            对外 API（本文件）
 * - tag-core.uts         标签解析（共享 UTS 函数）
 * - NfcTagReceiver.kt    标签广播接收器 + 原生 Tag 队列（.kt 混编，官方支持方式）
 * ⚠️ manifest 声明的组件类必须写在 .kt：uni-app 云打包把插件所有 .uts 合并成单个
 *    index.kt，.uts 二级文件里的 class 会被静默丢弃（实测 dex 只有 IndexKt）→ CNF 崩溃。
 *
 * 扫描机制（参照 Sfiora 成品插件架构）：enableForegroundDispatch +
 * PendingIntent.getBroadcast 指向 NfcTagReceiver.kt；标签以显式广播送达现有 App 进程，
 * 接收器只把 Tag 入静态队列，解析/写入全部在 JS 轮询发起的调用栈内完成。
 * 标签调起 App：由 manifest.json 的 railgo:// scheme（挂在 PandoraEntry）+ 标签内
 * AAR/URI 记录完成，与本插件的前台扫描链路无关。
 *
 * Kotlin 互操作约定（由云打包编译日志逐轮校正）：
 * - 禁止对原生数组/字符串做 [i] 下标（index 需 Int）：ByteArray 用 joinToString(",") 解析，
 *   String[] 用 joinToString 后走 UTS split 通道；
 * - UTS 自身数组下标必须经 at() 判空后参与运算，charCodeAt 经 codeAt()；
 * - 仅可用 Kotlin 1.0 时代 stdlib（concatToString 等 1.4+ API 不可用）；
 * - Ndef.getMaxSupportedSize()/maxSupportedSize 两种写法均不可用，容量按 NTAG 型号推算；
 * - 目标组件用 Intent().setClassName(pkg, cls)（规避 ComponentName/Class.forName）；
 * - 传给原生 Int 参数用 .toInt()（readPages/writePage/flags 已验证可行）；
 * - 原生组件类只能写在 .kt 混编文件（.uts 里任何位置的 class 声明都不会进 dex，见上）；
 * - Charsets/joinToString 来自 Kotlin 默认导入（kotlin.text），不要显式 import。
 */
import Activity from 'android.app.Activity'
import Intent from 'android.content.Intent'
import PendingIntent from 'android.app.PendingIntent'
import Build from 'android.os.Build'
import NfcAdapter from 'android.nfc.NfcAdapter'
import Tag from 'android.nfc.Tag'
import Ndef from 'android.nfc.tech.Ndef'
import NdefFormatable from 'android.nfc.tech.NdefFormatable'
import NfcA from 'android.nfc.tech.NfcA'
import NdefMessage from 'android.nfc.NdefMessage'
import {
	ERR_NOT_SUPPORT, ERR_NFC_DISABLED, ERR_NO_TAG, ERR_NOT_FORMATTED,
	ERR_READONLY, ERR_NOT_ENOUGH_SPACE, ERR_WRITE_FAILED,
	ERR_INVALID_PARAM,
	NfcStatusInfo, NfcTagInfo, NdefRecordSpec, StartScanOptions, WriteOptions,
	at, sliceBytes, buildMessageBytes, modelFromGetVersion,
	buildT2tUserArea, buildCcPage, T2T_USER_START_PAGE
} from '../interface.uts'
import {
	kb2n, n2kb, tagToBasicInfo, lastInfo, setLastInfo
} from './tag-core.uts'
// 原生混编：manifest 声明的接收器类（含静态 Tag 队列）在 NfcTagReceiver.kt
import { NfcTagReceiver } from 'com.railgo.nfc'

/* ==================== 模块状态 ==================== */

// 注意：本插件不存储/不回调任何"跨调用"的 JS 函数。
// UTS 的 JS 回调在本次调用结束后即被框架释放，后续再调用会报
// "回调函数已释放，不能再次执行" 并直接崩溃（keepalive 对嵌套在 options 对象里的回调不生效）。
// 发现事件走队列 + 轮询消费；仅 writeNdef 的 success/fail 在同一 JS 调用栈内同步触发，安全。
let gScanning = false

const TAG_RECEIVER = 'com.railgo.nfc.NfcTagReceiver'

function emitError(code : number, message : string) {
	// 只打日志；错误对外通过 writeNdef 的 fail 回调（同调用栈）或返回值传递
	console.error('[railgo-nfc] ' + code + ': ' + message)
}

function getAdapter() : NfcAdapter | null {
	const ctx = UTSAndroid.getAppContext()
	if (ctx == null) return null
	return NfcAdapter.getDefaultAdapter(ctx)
}

/* ==================== 对外 API ==================== */

export function checkStatus() : NfcStatusInfo {
	const adapter = getAdapter()
	let enabled = false
	if (adapter != null) {
		enabled = (adapter as NfcAdapter).isEnabled()
	}
	return {
		supported: adapter != null,
		enabled: enabled
	} as NfcStatusInfo
}

/** 返回 NFC 状态。options 中的回调已停用（跨调用回调会被释放导致崩溃），
 *  发现事件请轮询 hasStartupTag()/takeStartupTag() 消费。 */
export function initNfc(options : StartScanOptions | null) : NfcStatusInfo {
	return checkStatus()
}

export function onTagDiscovered(cb : (tag : NfcTagInfo) => void) : void { }
export function offTagDiscovered() : void { }
export function onError(cb : (code : number, message : string) => void) : void { }
export function offError() : void { }
export function onScanStopped(cb : (reason : string) => void) : void { }
export function offScanStopped() : void { }

function buildDispatchPendingIntent(activity : Activity) : PendingIntent {
	// 参照 Sfiora：前台分发目标用广播接收器（不起新 Activity、无冷启动/回调上下文问题）
	const pi = new Intent()
	pi.setClassName(activity.getPackageName(), TAG_RECEIVER)
	let flags = PendingIntent.FLAG_UPDATE_CURRENT
	if (Build.VERSION.SDK_INT >= 31) {
		// 系统需向该 Intent 填充 EXTRA_TAG，必须 MUTABLE
		flags = PendingIntent.FLAG_MUTABLE | PendingIntent.FLAG_UPDATE_CURRENT
	}
	return PendingIntent.getBroadcast(activity, 0, pi, flags.toInt())
}

export function startScan(options : StartScanOptions | null) : boolean {
	const adapter = getAdapter()
	if (adapter == null) {
		emitError(ERR_NOT_SUPPORT, '设备不支持 NFC')
		return false
	}
	const ad = adapter as NfcAdapter
	if (!ad.isEnabled()) {
		emitError(ERR_NFC_DISABLED, 'NFC 未开启，请到系统设置开启')
		return false
	}
	// 注意：不短路 gScanning——enableForegroundDispatch 在 Activity pause 后自动失效，
	// pause/resume 往返（如跳系统 NFC 设置）后必须重新调用才能恢复分发；重复 enable 幂等。
	const activity = UTSAndroid.getUniActivity()
	if (activity == null) {
		emitError(ERR_INVALID_PARAM, '无法获取前台 Activity')
		return false
	}
	try {
		ad.enableForegroundDispatch(activity as Activity, buildDispatchPendingIntent(activity as Activity), null, null)
		gScanning = true
		return true
	} catch (e : any) {
		emitError(ERR_INVALID_PARAM, '启动扫描失败: ' + e)
		return false
	}
}

export function stopScan() : void {
	if (!gScanning) return
	const adapter = getAdapter()
	const activity = UTSAndroid.getUniActivity()
	if (adapter != null && activity != null) {
		try {
			(adapter as NfcAdapter).disableForegroundDispatch(activity as Activity)
		} catch (e : any) {
			// 忽略
		}
	}
	gScanning = false
}

export function isScanning() : boolean {
	return gScanning
}

/** 队列里是否已有接收器收到的标签（boolean 跨桥可靠，作为轮询判据；
 *  takeStartupTag 空队列时返回 null 经桥可能被误判为非空） */
export function hasStartupTag() : boolean {
	return NfcTagReceiver.hasPending()
}

/** 消费接收器收到的标签：只读元数据（不建立 tech 会话），Tag 保持新鲜供 writeNdef 使用 */
export function takeStartupTag() : NfcTagInfo | null {
	const raw = NfcTagReceiver.takePendingTag()
	if (raw == null) return null
	try {
		const info = tagToBasicInfo(raw as Tag)
		setLastInfo(info)
		return info
	} catch (e : any) {
		console.error('[railgo-nfc] tag meta failed: ' + e)
		return null
	}
}

export function getLastTag() : NfcTagInfo | null {
	return lastInfo()
}

/** 应用包名（写 AAR 记录用，系统调起时据此直跳本 App 不弹选择框） */
export function getPackageName() : string {
	const ctx = UTSAndroid.getAppContext()
	if (ctx == null) return ''
	return ctx.getPackageName()
}

/* ==================== T2T 逐页写入（空白标签兜底路径） ==================== */

/**
 * 单 NfcA 会话完成：GET_VERSION 探测型号 → 读 CC → 写 CC（空白）→ 逐页写用户区。
 * 全程只用 NfcA transceive（不切 MifareUltralight tech、不 close），符合"一 Tag 一会话"约束。
 * 尾页 RFUI 由 buildT2tUserArea 补 0x00。
 */
function t2tRawWrite(tagRef : Tag, msgBytes : number[]) : boolean {
	const nfcA = NfcA.get(tagRef)
	if (nfcA == null) return false
	try {
		nfcA.connect()
		// GET_VERSION 探测型号（失败按 NTAG213 默认）
		let userBytes = 144
		let lastPage = 39
		try {
			const ver = kb2n(nfcA.transceive(n2kb([0x60])))
			if (ver.length >= 7) {
				const m = modelFromGetVersion(ver)
				userBytes = m.userBytes
				lastPage = m.lastPage
			}
		} catch (e : any) { }
		if (msgBytes.length + 2 > userBytes) {
			emitError(ERR_NOT_ENOUGH_SPACE, '数据 ' + msgBytes.length + 'B 超出标签容量 ' + userBytes + 'B')
			return false
		}
		const user = buildT2tUserArea(msgBytes, userBytes)
		if (user.length == 0) return false
		// 读页 0~3 检查 CC（页 2 首字节 0xE1）
		const head = kb2n(nfcA.transceive(n2kb([0x03, 0])))
		if (at(head, 8) != 0xE1) {
			const cc = buildCcPage(userBytes)
			nfcA.transceive(n2kb([0xA2, 2, at(cc, 0), at(cc, 1), at(cc, 2), at(cc, 3)]))
		}
		let page = T2T_USER_START_PAGE
		const endPage = lastPage - T2T_USER_START_PAGE + 1
		let written = 0
		while (written < endPage) {
			const d = sliceBytes(user, written * 4, 4)
			nfcA.transceive(n2kb([0xA2, page, at(d, 0), at(d, 1), at(d, 2), at(d, 3)]))
			page += 1
			written += 1
		}
		return true
	} catch (e : any) {
		emitError(ERR_WRITE_FAILED, 'T2T 逐页写入失败: ' + e)
		return false
	}
}

/* ==================== 写入 NDEF ==================== */

export function writeNdef(records : NdefRecordSpec[], options : WriteOptions | null) : void {
	const opts = options
	const fail = (code : number, msg : string) => {
		emitError(code, msg)
		if (opts != null) {
			const fcb = opts.fail
			if (fcb != null) fcb(code, msg)
		}
	}
	const done = (info : NfcTagInfo) => {
		setLastInfo(info)
		if (opts != null) {
			const scb = opts.success
			if (scb != null) scb(info)
		}
	}

	if (records.length == 0) {
		fail(ERR_INVALID_PARAM, '记录参数不合法')
		return
	}
	const tagObj = NfcTagReceiver.peekLastTag()
	if (tagObj == null) {
		fail(ERR_NO_TAG, '尚未发现标签，请 startScan 后贴标并轮询 takeStartupTag()')
		return
	}
	const tagRef = tagObj as Tag
	const msgBytes = buildMessageBytes(records)
	if (msgBytes.length == 0) {
		fail(ERR_INVALID_PARAM, '记录参数不合法')
		return
	}
	// 诊断：分发 Parcel 缓存的 techList 与待写字节数（判断走哪条写入路径的关键证据）
	console.log('[railgo-nfc] write begin bytes=' + msgBytes.length + ' techs=' + tagRef.getTechList().joinToString(","))
	let formatBlank = true
	if (opts != null && opts.formatBlank != null) {
		formatBlank = opts.formatBlank as boolean
	}

	// 1) 已格式化：Ndef 单会话直写（不探测型号、不 close；容量由写入异常兜底）
	const ndef = Ndef.get(tagRef)
	if (ndef == null) console.log('[railgo-nfc] branch: Ndef.get => null')
	if (ndef != null) {
		const drv = ndef as Ndef
		try {
			drv.connect()
			if (!drv.isWritable()) {
				fail(ERR_READONLY, '标签已设为只读/已锁定')
				return
			}
			drv.writeNdefMessage(new NdefMessage(n2kb(msgBytes)))
			done(tagToBasicInfo(tagRef))
			return
		} catch (e : any) {
			// 本 Tag 已作废：报失败，组件回到 scan 态，用系统重新分发的新 Tag 自动重试
			fail(ERR_WRITE_FAILED, 'Ndef 会话写入失败: ' + e)
			return
		}
	}

	if (formatBlank) {
		// 2) 空白标签：NdefFormatable 单会话格式化
		const fmt = NdefFormatable.get(tagRef)
		if (fmt == null) console.log('[railgo-nfc] branch: NdefFormatable.get => null, 走 T2T')
		if (fmt != null) {
			const fd = fmt as NdefFormatable
			try {
				fd.connect()
				fd.format(new NdefMessage(n2kb(msgBytes)))
				done(tagToBasicInfo(tagRef))
				return
			} catch (e : any) {
				fail(ERR_WRITE_FAILED, 'NdefFormatable 格式化失败: ' + e)
				return
			}
		}
		// 3) T2T 逐页写兜底（NTAG213/215/216；单 NfcA 会话）
		if (t2tRawWrite(tagRef, msgBytes)) {
			done(tagToBasicInfo(tagRef))
			return
		}
		fail(ERR_WRITE_FAILED, '写入失败：标签不支持 Ndef/NdefFormatable 或逐页写入被拒绝（可能已加密/锁定）')
		return
	}
	fail(ERR_NOT_FORMATTED, '空白标签未格式化（formatBlank=false）')
}

/* ==================== 便捷写入 ==================== */

export function uriRecord(uri : string) : NdefRecordSpec {
	return { type: 'uri', uri: uri } as NdefRecordSpec
}
export function textRecord(text : string, language : string) : NdefRecordSpec {
	return { type: 'text', text: text, language: language } as NdefRecordSpec
}
/** AAR：写入 Android 包名，Android 端优先据此调起 App */
export function aarRecord(packageName : string) : NdefRecordSpec {
	return { type: 'aar', packageName: packageName } as NdefRecordSpec
}

/** 常用一步写法：只写一条 URI 记录 */
export function writeUri(uri : string, options : WriteOptions | null) : void {
	writeNdef([uriRecord(uri)], options)
}
