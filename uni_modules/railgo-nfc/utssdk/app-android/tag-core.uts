/**
 * railgo-nfc Android 内部核心：标签解析（纯 UTS 函数，供 index.uts 调用）
 *
 * ⚠️ uni-app 云打包会把插件所有 .uts 合并成单个 index.kt：.uts 二级文件只保留顶层函数，
 * class 声明会被静默丢弃。因此 manifest 声明的原生组件（NfcTagReceiver）必须用
 * NfcTagReceiver.kt 原生文件实现，标签队列也存放在该 kt 的伴生对象里。
 * 依赖方向只能是 index.uts → tag-core.uts / NfcTagReceiver.kt。
 *
 * ⚠️ Android Tag 连接会话铁律（实测 IOException 校正）：
 * - 同一 Tag 同时只允许一个 tech 处于 connect 状态（"Only one TagTechnology can be
 *   connected at a time"）；
 * - 任何 close()（或连接后出错）都会使该 Tag 对象作废，后续 connect 必抛 IOException；
 * - 因此：takeStartupTag 用 tagToBasicInfo 只读元数据（getId/getTechList，不建会话），
 *   保持 Tag 新鲜给 writeNdef；每条写入路径都是单 tech 单会话、全程不 close；
 *   写失败不重试该 Tag——系统在标签在场期间会反复重新分发（队列持续进新 Tag），
 *   组件轮询自然用新 Tag 重试。
 * 完整读取解析（tagToInfo，多 tech 会话）仅供独立读标签场景在新 Tag 上调用。
 */
import Tag from 'android.nfc.Tag'
import Ndef from 'android.nfc.tech.Ndef'
import NdefFormatable from 'android.nfc.tech.NdefFormatable'
import NfcA from 'android.nfc.tech.NfcA'
import MifareUltralight from 'android.nfc.tech.MifareUltralight'
import NdefMessage from 'android.nfc.NdefMessage'
import {
	NfcTagInfo, NdefRecordData, NtagModel, at, sliceBytes, bytesToHex,
	parseMessageBytes, extractT2tNdef, modelFromGetVersion, T2T_USER_START_PAGE
} from '../interface.uts'

/* ==================== 共享状态 ==================== */

let gCurrentInfo : NfcTagInfo | null = null

export function lastInfo() : NfcTagInfo | null {
	return gCurrentInfo
}

export function setLastInfo(info : NfcTagInfo) : void {
	gCurrentInfo = info
}

/* ==================== 字节互转工具 ==================== */

/**
 * ByteArray → number[]：
 * 禁止 b[i] 下标（原生数组 index 需要 Int，UTS number 传入报参数类型错）。
 * 用 Kotlin 1.0 stdlib joinToString 转带符号十进制列表字符串，再走 UTS 字符串通道解析。
 */
export function kb2n(b : ByteArray) : number[] {
	// joinToString 属 Kotlin 1.0 stdlib（concatToString 是 1.4+，本编译环境不可用）
	// 元素为带符号十进制：-3 → 253
	const out : number[] = []
	const s = b.joinToString(",")
	for (const part of s.split(",")) {
		const t = part.trim()
		if (t.length == 0) continue
		const v = parseInt(t, 10)
		if (v == null) continue
		let n = v as number
		if (n < 0) n = n + 256
		out.push(n)
	}
	return out
}

/** number[](0~255) → Kotlin ByteArray：latin1 每字符恰为一字节 */
export function n2kb(a : number[]) : ByteArray {
	let s = ''
	for (let i = 0; i < a.length; i++) {
		s += String.fromCharCode((at(a, i) & 0xFF).toInt())
	}
	return s.toByteArray(Charsets.ISO_8859_1)
}

/* ==================== 标签解析 ==================== */

/** 轻量元数据解析：只读 getId/getTechList，不建立任何 tech 会话（Tag 保持可写状态） */
export function tagToBasicInfo(tagRef : Tag) : NfcTagInfo {
	const uid = bytesToHex(kb2n(tagRef.getId()))
	const techs : string[] = []
	const tls = tagRef.getTechList().joinToString(",")
	for (const full of tls.split(',')) {
		if (full.length == 0) continue
		const idx = full.lastIndexOf('.')
		techs.push(idx >= 0 ? full.substring(idx + 1) : full)
	}
	return {
		uid: uid,
		techList: techs,
		tagType: 'Type2',
		userBytes: 0,
		maxNdefSize: 0,
		formatted: false,
		writable: false,
		records: null
	} as NfcTagInfo
}

export function readVersionModel(tagRef : Tag) : NtagModel {
	const nfcA = NfcA.get(tagRef)
	if (nfcA == null) return { model: 'Type2 (unknown)', userBytes: 144, lastPage: 39 } as NtagModel
	try {
		nfcA.connect()
		const resp = kb2n(nfcA.transceive(n2kb([0x60])))
		nfcA.close()
		if (resp.length >= 7) return modelFromGetVersion(resp)
	} catch (e : any) {
		// GET_VERSION 失败按默认处理
	}
	return { model: 'Type2 (unknown)', userBytes: 144, lastPage: 39 } as NtagModel
}

/** 通过 MifareUltralight/NfcA 读取用户区原始字节（页 4 起） */
function readUserBytesRaw(tagRef : Tag, lastPage : number) : number[] {
	// 优先 MifareUltralight.readPages（每次 4 页）
	const ml = MifareUltralight.get(tagRef)
	if (ml != null) {
		try {
			ml.connect()
			const out : number[] = []
			let page = T2T_USER_START_PAGE
			while (page <= lastPage) {
				const chunk = kb2n(ml.readPages(page.toInt()))
				for (let k = 0; k < chunk.length; k++) out.push(at(chunk, k))
				page += 4
			}
			ml.close()
			const total = (lastPage - T2T_USER_START_PAGE + 1) * 4
			return sliceBytes(out, 0, total)
		} catch (e : any) {
			// 落入 NfcA 逐块读
		}
	}
	const nfcA = NfcA.get(tagRef)
	if (nfcA == null) return [] as number[]
	try {
		nfcA.connect()
		const out : number[] = []
		let page = T2T_USER_START_PAGE
		while (page <= lastPage) {
			const chunk = kb2n(nfcA.transceive(n2kb([0x03, page])))
			for (let k = 0; k < chunk.length; k++) out.push(at(chunk, k))
			page += 4
		}
		nfcA.close()
		const total = (lastPage - T2T_USER_START_PAGE + 1) * 4
		return sliceBytes(out, 0, total)
	} catch (e : any) {
		return [] as number[]
	}
}

export function tagToInfo(tagRef : Tag) : NfcTagInfo {
	const uid = bytesToHex(kb2n(tagRef.getId()))
	const techs : string[] = []
	// 原生 Array<String> 不做下标遍历：joinToString 后走 UTS 字符串数组通道
	const tls = tagRef.getTechList().joinToString(",")
	for (const full of tls.split(',')) {
		if (full.length == 0) continue
		const idx = full.lastIndexOf('.')
		techs.push(idx >= 0 ? full.substring(idx + 1) : full)
	}
	const model = readVersionModel(tagRef)

	let formatted = false
	let writable = false
	let maxNdefSize = model.userBytes - 4
	let records : NdefRecordData[] | null = null

	const ndef = Ndef.get(tagRef)
	if (ndef != null) {
		formatted = true
		try {
			ndef.connect()
			// getMaxSupportedSize/maxSupportedSize 在 UTS 编译环境均不可用，容量按 NTAG 型号推算
			writable = ndef.isWritable()
			const msg = ndef.getCachedNdefMessage()
			if (msg != null) {
				records = parseMessageBytes(kb2n((msg as NdefMessage).toByteArray()))
			} else {
				records = [] as NdefRecordData[]
			}
			try { ndef.close() } catch (e2 : any) { }
		} catch (e : any) {
			try { ndef.close() } catch (e2 : any) { }
			// 缓存缺失时走 T2T 逐页读 + TLV 解析兜底
			const raw = readUserBytesRaw(tagRef, model.lastPage)
			if (raw.length > 0) {
				const msgBytes = extractT2tNdef(raw)
				if (msgBytes.length > 0) records = parseMessageBytes(msgBytes)
			}
			writable = true
		}
	} else {
		// 无 Ndef 技术：可能为空白标签，逐页读检查 CC 与 TLV
		const raw = readUserBytesRaw(tagRef, model.lastPage)
		if (raw.length > 0) {
			const msgBytes = extractT2tNdef(raw)
			if (msgBytes.length > 0) {
				records = parseMessageBytes(msgBytes)
				formatted = true
			}
		}
		writable = NdefFormatable.get(tagRef) != null
	}

	return {
		uid: uid,
		techList: techs,
		tagType: model.model,
		userBytes: model.userBytes,
		maxNdefSize: maxNdefSize,
		formatted: formatted,
		writable: writable,
		records: records
	} as NfcTagInfo
}
