import {
  InvokeSfioraNative, SfioraNativeCallback, GetCapabilities, StartScan,
  CancelScan, IsScanning, WriteNdef, InitializeNdef, CancelWrite, IsWriting, WaitForIdle, AcquireForegroundDispatch, ReleaseForegroundDispatch, GetForegroundDispatchState, GetPresentationState, WaitForPresentationEnd,
} from '../interface.uts'
import { invokeObject, invokeOwner, invokeBoolean, invokeVoid, waitForNativeIdle } from '../bridge.uts'
export { SfioraError } from '../bridge.uts'
import SfioraBridgeLifecycle from 'com.sandrox.sfiora.bridge.SfioraBridgeLifecycle'
import SfioraBridgeJsonCallback from 'com.sandrox.sfiora.bridge.SfioraBridgeJsonCallback'

class RuntimeCallback implements SfioraBridgeJsonCallback {
  private callback: SfioraNativeCallback
  constructor(callback: SfioraNativeCallback) {
    this.callback = callback
  }
  override onResult(json: string): void {
    this.callback(json)
  }
}

export const invokeSfioraNative: InvokeSfioraNative = function(method: string, argumentsJson: string, callback: SfioraNativeCallback): void {
  // Capability queries still work before an Activity exists.
  SfioraBridgeLifecycle.getShared().invokeJson(UTSAndroid.getUniActivity(), UTSAndroid.getAppContext(), method, argumentsJson, new RuntimeCallback(callback))
}

export const getCapabilities: GetCapabilities = function(): Promise<UTSJSONObject> {
  return invokeObject(invokeSfioraNative, 'getCapabilities', [])
}
export const startScan: StartScan = function(options?: UTSJSONObject): Promise<UTSJSONObject> {
  return invokeObject(invokeSfioraNative, 'startScan', [options ?? {}])
}
export const cancelScan: CancelScan = function(): Promise<void> {
  return invokeVoid(invokeSfioraNative, 'cancelScan')
}
export const isScanning: IsScanning = function(): Promise<boolean> {
  return invokeBoolean(invokeSfioraNative, 'isScanning')
}
export const writeNdef: WriteNdef = function(message: UTSJSONObject, options?: UTSJSONObject): Promise<UTSJSONObject> {
  return invokeObject(invokeSfioraNative, 'writeNdef', [message, options ?? {}])
}
export const initializeNdef: InitializeNdef = function(message: UTSJSONObject, marker: UTSJSONObject, options?: UTSJSONObject): Promise<UTSJSONObject> {
  return invokeObject(invokeSfioraNative, 'initializeNdef', [message, marker, options ?? {}])
}
export const cancelWrite: CancelWrite = function(): Promise<void> {
  return invokeVoid(invokeSfioraNative, 'cancelWrite')
}
export const isWriting: IsWriting = function(): Promise<boolean> {
  return invokeBoolean(invokeSfioraNative, 'isWriting')
}

export const waitForIdle: WaitForIdle = function(options?: UTSJSONObject): Promise<void> {
  return waitForNativeIdle(invokeSfioraNative, options)
}

export const acquireForegroundDispatch: AcquireForegroundDispatch = function(ownerId: string): Promise<UTSJSONObject> {
  return invokeOwner(invokeSfioraNative, 'acquireForegroundDispatch', ownerId)
}
export const releaseForegroundDispatch: ReleaseForegroundDispatch = function(ownerId: string): Promise<UTSJSONObject> {
  return invokeOwner(invokeSfioraNative, 'releaseForegroundDispatch', ownerId)
}
export const getForegroundDispatchState: GetForegroundDispatchState = function(): Promise<UTSJSONObject> {
  return invokeObject(invokeSfioraNative, 'getForegroundDispatchState', [])
}
export const getPresentationState: GetPresentationState = function(): Promise<UTSJSONObject> {
  return invokeObject(invokeSfioraNative, 'getPresentationState', [])
}
export const waitForPresentationEnd: WaitForPresentationEnd = function(options?: UTSJSONObject): Promise<void> {
  return invokeVoid(invokeSfioraNative, 'waitForPresentationEnd', [options ?? {}])
}
